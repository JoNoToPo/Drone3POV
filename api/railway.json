{
  "$schema": "https://railway.com/railway.schema.json",
  "deploy": {
    "startCommand": "python scripts/download_model.py && uvicorn app.main:app --host 0.0.0.0 --port $PORT --proxy-headers --forwarded-allow-ips '*'",
    "healthcheckPath": "/doc/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
